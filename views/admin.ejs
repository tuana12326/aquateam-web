<%-include('head')%>
<div class="adm"><a href="/admin"><b>Panel</b></a><%for(const k in S){%><a href="/admin/<%=k%>"><%=LBL[k]%></a><%}%><a href="/admin/files">Dosyalar</a><form method="post" action="/admin/logout"><button>Çıkış</button></form></div>
<h1><%=title%></h1>
<%if(mode=='home'){%><h2>Gelen Mesajlar</h2><%if(!msgs.length){%><p class="muted">Henüz mesaj yok.</p><%}%><%for(const m of msgs){%><div class="card" style="margin-bottom:10px"><small class="muted"><%=m.created.slice(0,16)%> · <%=m.kind%></small><br><%for(const k in m.d){%><b><%=k%>:</b> <%=m.d[k]%><br><%}%></div><%}%><%}%>
<%if(mode=='files'){%><%if(q.ok){%><p class="ok">Yüklendi.</p><%}%><form method="post" enctype="multipart/form-data" class="card"><%const N={logo:'Takım logosu (PNG, şeffaf)',sponsor:'Sponsorluk dosyası (PDF)',model:'3D model (.glb)',coral:'CORAL Arayüz ekran görüntüsü (PNG)',presskit:'Basın kiti (ZIP)'};for(const k in FILES){%><label><%=N[k]%> <%if(has(FILES[k])){%><span class="ok">● yüklü</span><%}%><input type="file" name="<%=k%>"></label><%}%><button>Yükle</button></form><%}%>
<%if(mode=='list'){%><p><a class="btn" href="/admin/<%=t%>/form">+ Yeni ekle</a></p><div class="tw"><table><%for(const r of rows){%><tr><td><%=r[S[t][0]]%></td><td><%=r[S[t][1]]||''%></td><td><a href="/admin/<%=t%>/form/<%=r.id%>">Düzenle</a></td><td><form method="post" action="/admin/<%=t%>/<%=r.id%>/delete" onsubmit="return confirm('Silinsin mi?')"><button>Sil</button></form></td></tr><%}%></table></div><%}%>
<%if(mode=='form'){%><form method="post" action="/admin/<%=t%>/save" enctype="multipart/form-data" class="card"><%if(q.err){%><p class="err">İlk alan zorunludur.</p><%}%><input type="hidden" name="id" value="<%=row.id||''%>">
<%for(const c of S[t]){%><label><%=c%><%if(c.startsWith('body')){%><textarea name="<%=c%>"><%=row[c]||''%></textarea><%}else if(c=='alumni'){%><input type="checkbox" name="alumni" value="1" <%=row.alumni?'checked':''%> style="width:auto"><%}else{%><input name="<%=c%>" type="<%=c=='date'?'date':'text'%>" value="<%=row[c]||''%>"><%}%></label><%}%>
<%if(t=='gallery'||t=='sponsors'){%><label>Dosya yükle (URL alanının yerine geçer)<input type="file" name="file" accept="image/*,video/mp4"></label><%}%><button>Kaydet</button></form><%}%>
<%-include('foot')%>
